# Supabase — copie para .env.local e preencha com os valores do seu projeto
# (Painel Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# NUNCA exponha a service_role key com prefixo NEXT_PUBLIC_.
# Se precisar dela (ex. rotina de importação em massa que ignora RLS),
# use apenas em Server Actions/Route Handlers e sem o prefixo NEXT_PUBLIC_:
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
